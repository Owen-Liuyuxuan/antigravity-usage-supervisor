<Window x:Class="AntigravityUsageSupervisor.UsageFlyout" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Antigravity Usage Supervisor" Width="390" Height="720" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" Background="#F2FAFD" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13">
 <WindowChrome.WindowChrome><WindowChrome CaptionHeight="0" CornerRadius="12" GlassFrameThickness="0" ResizeBorderThickness="0"/></WindowChrome.WindowChrome>
 <Border BorderBrush="#D2E5EE" CornerRadius="12" BorderThickness="1" Padding="24,20">
  <DockPanel>
   <Grid DockPanel.Dock="Top" Margin="0,0,0,18">
    <TextBlock Text="ANTIGRAVITY" FontSize="23" FontWeight="SemiBold"/>
    <TextBlock Text="USAGE SUPERVISOR" Foreground="#627D8C" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
   </Grid>
   <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
    <TextBlock x:Name="Status" Text="连接中…" Foreground="#627D8C" FontSize="11" Margin="0,0,0,12"/>
    <StackPanel Orientation="Horizontal"><Button x:Name="RefreshButton" Content="刷新" Click="RefreshClick"/><Button Content="设置" Click="SettingsClick"/><Button Content="收起" Click="HideClick"/></StackPanel>
   </StackPanel>
   <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
     <TextBlock Text="账户用量 · 已用比例" Foreground="#627D8C" Margin="0,0,0,12"/>
     <StackPanel x:Name="Quotas" Margin="0,0,0,16"><TextBlock Text="正在获取账户额度…" Foreground="#627D8C"/></StackPanel>
     <TextBlock Text="今日活动 · 本机估算" Foreground="#627D8C" FontSize="11"/>
     <TextBlock x:Name="Today" Text="—" FontSize="18" Margin="0,8,0,22"/>
     <TextBlock Text="最近任务" Foreground="#627D8C" FontSize="11" Margin="0,0,0,4"/>
     <StackPanel x:Name="Recent"/>
    </StackPanel>
   </ScrollViewer>
  </DockPanel>
 </Border>
</Window>
